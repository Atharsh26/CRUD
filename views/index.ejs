<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Records</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Hero header -->
  <div class="hero text-center mb-5">
    <div class="container">
      <h1 class="fw-heading fw-semibold mb-2">CRUD</h1>
      <p class="mb-0">Create, Read, Update, and Delete student data &mdash; stored in MongoDB</p>
    </div>
  </div>

  <div class="container pb-5">

    <!-- editingStudent is null on the normal page, set when we come from /edit/:id -->
    <div class="card p-4 mb-4">
      <h2 class="fw-heading h5 mb-3">
        <% if (editingStudent) { %>
          Update a Student Record :
        <% } else { %>
          Create a Student Record :
        <% } %>
      </h2>

      <form action="/save" method="POST" class="row g-3">
        <!-- empty id = new record, filled id = updating that record -->
        <input type="hidden" name="id" value="<%= editingStudent ? editingStudent._id : '' %>">

        <div class="col-md-6">
          <label class="form-label" for="name">Name</label>
          <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Saravana Kumar"
                 value="<%= editingStudent ? editingStudent.name : '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="rollNo">Roll No.</label>
          <input type="text" class="form-control" id="rollNo" name="rollNo" placeholder="e.g. CS-105"
                 value="<%= editingStudent ? editingStudent.rollNo : '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="course">Course</label>
          <input type="text" class="form-control" id="course" name="course" placeholder="e.g. Computer Science"
                 value="<%= editingStudent ? editingStudent.course : '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="email">Email</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com"
                 value="<%= editingStudent ? editingStudent.email : '' %>" required>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="marks">Marks</label>
          <input type="number" class="form-control" id="marks" name="marks" min="0" max="100" placeholder="0-100"
                 value="<%= editingStudent && editingStudent.marks !== undefined && editingStudent.marks !== null ? editingStudent.marks : '' %>">
        </div>

        <div class="col-12 text-end">
          <% if (editingStudent) { %>
            <a href="/" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-check-lg"></i> Save Changes
            </button>
          <% } else { %>
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-plus-lg"></i> Create Student Record
            </button>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Students table -->
    <div class="card p-4">
      <h2 class="fw-heading h5 mb-3">All Student Records<span class="text-muted fw-normal">(<%= students.length %>)</span></h2>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Roll No.</th>
              <th>Course</th>
              <th>Email</th>
              <th>Marks</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr class="empty-row">
                <td colspan="6">No students added yet. Use the form above to add one.</td>
              </tr>
            <% } else { %>
              <% students.forEach(student => { %>
                <tr>
                  <td class="fw-medium"><%= student.name %></td>
                  <td><%= student.rollNo %></td>
                  <td><%= student.course %></td>
                  <td class="text-muted"><%= student.email %></td>
                  <td>
                    <% if (student.marks !== undefined && student.marks !== null) { %>
                      <span class="badge-marks badge <%= student.marks >= 40 ? 'text-success' : 'text-danger' %>">
                        <%= student.marks %>
                      </span>
                    <% } else { %>
                      <span class="text-muted">&mdash;</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/edit/<%= student._id %>" class="btn btn-sm btn-outline-secondary">
                      <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form action="/delete/<%= student._id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this record?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i> Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

</body>
</html>
